# ==========================================
# Lumi - .gitignore
# ==========================================

# Rust build artifacts
/target/
**/target/

# TLS certificates and private keys — generated at runtime, never commit
certs/
*.pem
*.key
*.crt
*.der
*.p12
*.pfx

# Fuzz corpus and artifacts — local only, too large for version control
fuzz/corpus/
fuzz/artifacts/
fuzz/coverage/

# Backup files
*.bak
*.tmp
*.old
*.orig

# Logs
*.log

# IDE settings
.vscode/
.idea/
.fleet/
.vs/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Environment
.env
.env.*

# Temporary directories
tmp/
temp/

# Rust Analyzer
rust-project.json

# Coverage output
coverage/
*.profraw
*.profdata
default.profraw
lcov.info

# Lumi package outputs
*.lpkg
*.lpx

# Local Lumi config
lumi.toml

# Benchmark baseline files (criterion)
criterion/
